# Wise Business: Settings -> API tokens -> create a read-only token
WISE_API_TOKEN=
# Optional. Defaults to https://api.transferwise.com. Sandbox: https://api.sandbox.transferwise.tech
WISE_API_URL=

# Google Cloud OAuth desktop client. Scopes: gmail.readonly, drive.file, spreadsheets.
# Create at https://console.cloud.google.com/apis/credentials
# The refresh token is written to the state dir by `opentaxes auth google`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe restricted key with read access to invoices, charges, payouts and balance transactions.
STRIPE_SECRET_KEY=

# Only needed for the headless `opentaxes extract` path.
# When an agent drives the MCP server it reads the documents itself and no key is required.
ANTHROPIC_API_KEY=

# Where fetched documents and the monthly ledger live. Defaults to ./.opentaxes
OPENTAXES_STATE_DIR=
